# Slack app credentials (create the app at https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...        # Socket Mode token, for local dev
SLACK_SIGNING_SECRET=...        # required for SLACK_MODE=http (request signature verification)

# "socket" (default, local dev, no public URL needed) or "http"
# (gunicorn + Flask, for a free-tier Web Service host like Render — see
# slack_app.py's module docstring)
SLACK_MODE=socket

# LLM provider(s) — LiteLLM picks the first that works, same fallback pattern as ai-data-agent
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Knowledge base
KB_SOURCE_DIR=./docs
DUCKDB_PATH=./knowledge_base/kb.duckdb

# Channels
SUPPORT_INBOX_CHANNEL_ID=       # where customer questions come in
TEAM_REVIEW_CHANNEL_ID=         # where the human-approval thread is posted (private/internal channel)
