# Slack app, created from slack-app-manifest.yml (local, Socket Mode) or
# slack-app-manifest.http.yml (Render, HTTP mode) at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
# Checks the signature of every request Slack sends in HTTP mode
SLACK_SIGNING_SECRET=...
# Socket Mode only (local development); leave empty on Render
SLACK_APP_TOKEN=xapp-...

# "socket" (default, local development, no public URL needed) or "http"
# (gunicorn + Flask, for a Web Service host such as Render's free plan)
SLACK_MODE=socket

# Channel IDs: shown at the bottom of the channel details in Slack.
# Questions come in the support inbox (a public channel); drafts wait for
# review in the review channel. Invite the bot to both.
SUPPORT_INBOX_CHANNEL_ID=
TEAM_REVIEW_CHANNEL_ID=

# Provider keys for the models below
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Embedding model for the knowledge base. The relevance threshold below was
# measured for this model: re-run the evaluation after changing it.
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small

# Drafting model, then backup models tried in order when a call fails
# (comma-separated LiteLLM model names)
SUPPORT_COPILOT_LLM_MODEL=groq/openai/gpt-oss-120b
SUPPORT_COPILOT_LLM_FALLBACKS=openrouter/openai/gpt-oss-120b

# Passages below this cosine similarity are dropped before drafting
SUPPORT_COPILOT_MIN_RELEVANCE=0.33

# Knowledge base
KB_SOURCE_DIR=./docs
DUCKDB_PATH=./knowledge_base/kb.duckdb

# Optional
# SUPPORT_COPILOT_LLM_TIMEOUT=30
# AGENT_CHECKPOINT_PATH=agent_checkpoints.sqlite
